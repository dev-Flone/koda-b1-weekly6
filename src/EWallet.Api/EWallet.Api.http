
@baseUrl = http://localhost:5224

### ==============================
### USERS
### ==============================

### 1. Get All Users
GET {{baseUrl}}/api/users
Accept: application/json

### 2. Get User By ID
GET {{baseUrl}}/api/users/31
Accept: application/json

### 3. Create User
POST {{baseUrl}}/api/users
Content-Type: application/json

{
  "email": "dimas1@gmail.com",
  "phone": "081234567890",
  "fullName": "Dimas",
  "userName": "DimasNoMercy"
}

### 4. Update User
PUT {{baseUrl}}/api/users/31
Content-Type: application/json

{
  "email": "afif@gmail.com",
  "phone": "081234567891",
  "fullName": "Afif",
  "userName": "AfifNoMercy"
}


### ==============================
### WALLETS
### ==============================

### Get All Wallet
GET {{baseUrl}}/api/wallets
Accept: application/json

### Get By UserId
GET {{baseUrl}}/api/wallets/users/21
Accept: application/json

### Update Status
PATCH  {{baseUrl}}/api/wallets/31/status
Content-Type: application/json

{
  "status": "FROZEN"
}

### Get By Status
GET {{baseUrl}}/api/wallets/status/frozen
Accept: application/json

### Get By WalletNumber
GET {{baseUrl}}/api/wallets/number/WLT-2159775
Accept: application/json

### 5. Get Wallet By User ID
GET {{baseUrl}}/api/wallets/31
Accept: application/json


### ======================
### TOPUP
### =====================

### Top Up Wallet
POST {{baseUrl}}/api/topup/
Content-Type: application/json

{
  "walletId": "22",
  "amount": 1000000,
  "paymentMethodId": 1,
  "description": "Top up via HTTP request"
}

### Get By Id
GET {{baseUrl}}/api/topup/7
Accept: application/json

### Get All TopUp Requests
GET {{baseUrl}}/api/topup
Accept: application/json

### Get By WalletId
GET {{baseUrl}}/api/topup/wallet/22
Accept: application/json

### 7. Top Up - Invalid Amount
POST {{baseUrl}}/api/topup
Content-Type: application/json

{
  "amount": 0,
  "description": "Invalid top up"
}


### ==============================
### TRANSACTIONS
### ==============================

### Get All transactions
GET {{baseUrl}}/api/transaction
Accept: application/json

### Get By Id
GET {{baseUrl}}/api/transaction/16
Accept: application/json

### Get By Reference Number
GET {{baseUrl}}/api/transaction/reference/SEED-TOPUP-001
Accept: application/json

### Get By WalletId
GET {{baseUrl}}/api/transaction/wallet/21
Accept: application/json

### Get By Status
GET {{baseUrl}}/api/transaction/status/success
Accept: application/json

### Get By Type
GET {{baseUrl}}/api/transaction/type/transfer
Accept: application/json

